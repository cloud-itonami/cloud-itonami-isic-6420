{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj). This
 ;; repo is standalone (forkable outside the workspace); the :local/root
 ;; paths only resolve inside the monorepo checkout — a standalone fork
 ;; should override them with git coordinates.
 :deps {
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.robotics"}

        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}
        ;; html/css を top-level で git 座標に固定する。推移依存(:local/root)と
        ;; jp-go-dds(:git/sha)で座標型が違うと tools.deps が版を比較できない。
        io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.html"}
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.css"}
io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.langgraph"}
        ;; langchain-store: the shared langchain.db store seam (EDN-blob
        ;; codec + identity schema + event-log helpers) that ~190 actors
        ;; hand-roll; holdco.store is an adopter (ADR-2607141600).
        io.github.kotoba-lang/langchain-store
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.langchainStore"}
        ;; optional: holdco.corporate-intel's cross-reference into
        ;; cloud-itonami-isic-8291's :disclosure/ownership-chain op
        ;; (ADR-2607110400 addendum 4). Only holdco.corporate-intel itself
        ;; requires `dossier.*` -- holdcoadvisor/operation/governor have
        ;; zero compile-time dependency on it (the ownership-chain-fn is
        ;; plain-injected).
        io.github.cloud-itonami/cloud-itonami-isic-8291
        {:git/url "https://github.com/cloud-itonami/cloud-itonami-isic-8291.git"
         :git/sha "4e08e4fdee5e2eae8ff25ba9399fb645e8d7b899"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  ;; -d test/holdco: test/wasm/ hosts the .wasm build through kototama.tender on the JVM
  ;; (clojure.java.io, .readAllBytes) -- JVM-only by design, run by the :test alias.
  :physai-test {:extra-paths ["test" "test-physai"] :main-opts ["-m" "cognitect.test-runner" "-d" "test/holdco" "-d" "test-physai"]}
;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "holdco.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate docs/samples/operator-console.html
  ;; through the real actor (flagship checklist item 2, ADR-2607189300 Wave5 seq 6).
  :render-html {:main-opts ["-m" "holdco.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; kototama.tender hosts the wasm/distributable_reserves.kotoba
                      ;; build (see wasm/README.md) -- test-only, the actor's
                      ;; own runtime code has no wasm/host dependency.
                      io.github.kotoba-lang/kototama
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.kototama"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; PRIMARY gate: the same portable .cljc suite under a real
  ;; ClojureScript host (runtime priority: cljs first, JVM compat).
  ;;   kbb -Sdeps '{:paths ["src" "test"]}' -M:dev:cljs \
  ;;     -m cljs.main --target node -m holdco.portable-cljs-test-runner
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
